    rotation: 0
    state: true
- name: rx_gain
  id: variable
  parameters:
    comment: ''
    value: 1/(distance**2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [992, 32.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 32e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1064, 32.0]
    rotation: 0
    state: enabled
- name: snr
  id: variable
  parameters:
    comment: ''
    value: (rx_gain**2 / noise**2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 32.0]
    rotation: 0
    state: enabled
